{
  "name": "main: reviewed squash merges",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": { "include": ["refs/heads/main"], "exclude": [] }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": ["squash"],
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "rust", "integration_id": 15368 },
          { "context": "msrv", "integration_id": 15368 },
          { "context": "bitwarden-cli", "integration_id": 15368 },
          { "context": "embedded", "integration_id": 15368 },
          { "context": "codex/review-gate", "integration_id": 4602759 },
          { "context": "Runnerless / Codex review", "integration_id": 4602759 }
        ]
      }
    },
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" }
  ]
}
